<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing Key Store for Azure Key Vault</Title>
		<Description>Azure Key Vault backed crypto-shredding key stores for Purview EventSourcing, holding one secret per data subject or wrapping per-subject keys with a vault-held key.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;event-store;crypto-shredding;gdpr;azure-key-vault;key-vault;encryption;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" />
		<PackageReference Include="Azure.Security.KeyVault.Keys" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
	</ItemGroup>
</Project>
