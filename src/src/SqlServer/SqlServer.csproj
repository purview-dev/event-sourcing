<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Store for Azure SQL and SQL Server</Title>
		<Description>Azure SQL and SQL Server event stream storage provider for Purview EventSourcing.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;event-store;sql-server;azure-sql;events;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LinqKit" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
		<ProjectReference Include="..\ImplementationShared\ImplementationShared.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.csproj" />
		<ProjectReference
			Include="..\EntityFrameworkCore.SourceGenerator\EntityFrameworkCore.SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
			Pack="false"
		/>
	</ItemGroup>
</Project>
