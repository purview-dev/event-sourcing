<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing Admin Portal API</Title>
		<Description>ASP.NET Minimal API endpoints for Purview EventSourcing Admin Portal with OpenAPI documentation.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;admin;api;openapi;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Admin.Abstractions\Admin.Abstractions.csproj" />
		<ProjectReference Include="..\Admin.Security\Admin.Security.csproj" />
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Purview.ZodSharp" />
		<PackageReference Include="Purview.ZodSharp.AspNetCore" />
		<PackageReference Include="Purview.ZodSharp.SystemTextJson" />
	</ItemGroup>

	<PropertyGroup>
		<!-- The Microsoft.AspNetCore.OpenApi XML-comment source generator builds a cache of XML doc IDs across the
		     compilation and its references. Purview telemetry scaffolding re-declares the same types in several
		     assemblies, which makes that cache throw at runtime with a duplicate key when an OpenAPI document is
		     generated (see AddPurviewEventSourcingAdminOpenAPI). This analyzer is therefore not used by this
		     project. -->
		<RemoveOpenApiXmlCommentAnalyzer>true</RemoveOpenApiXmlCommentAnalyzer>
	</PropertyGroup>

	<Target
		Name="RemoveOpenApiXmlCommentAnalyzer"
		AfterTargets="ResolveReferences"
		Condition="'$(RemoveOpenApiXmlCommentAnalyzer)' == 'true'"
	>
		<ItemGroup>
			<Analyzer
				Remove="@(Analyzer)"
				Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'"
			/>
		</ItemGroup>
	</Target>
</Project>
