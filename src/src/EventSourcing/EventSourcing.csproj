<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing</Title>
		<Description>Core abstractions, aggregate types, facades, transactions, and dependency injection extensions for building event-sourced .NET applications.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;eventstore;event-store;aggregate;domain-driven-design;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\MirrorGenerator\MirrorGenerator.csproj"
			PrivateAssets="all"
			Pack="false"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
		/>
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\SourceGenerator.CodeFixes\SourceGenerator.CodeFixes.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<PropertyGroup>
		<!-- RSG1006: the failure unions deliberately share leaf cases - one vocabulary across read, save,
		     delete and restore - so each shared case gets its AsFailure helper generated for one union only.
		     The documented authoring rule is the union-receiver factory (Union.Failure(...)), and using the
		     wrong helper is a compile error rather than a silent mis-binding. See
		     docs/wiki/Result-And-Failure-Model.md. -->
		<NoWarn>$(NoWarn);RSG1006</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Purview.Results" />
		<PackageReference Include="Purview.ValueObjects" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Extensions\Microsoft\Extensions\DependencyInjection\Manifest\" />
		<Folder Include="Extensions\Microsoft\Extensions\DependencyInjection\Outbox\" />
	</ItemGroup>
</Project>
