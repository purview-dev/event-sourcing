<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing Admin Portal Postgres</Title>
		<Description>Postgres query adapters for Purview EventSourcing Admin Portal.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;admin;postgres;queries;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Admin.Abstractions\Admin.Abstractions.csproj" />
		<ProjectReference Include="..\Postgres\Postgres.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Extensions\Microsoft\Extensions\DependencyInjection\" />
	</ItemGroup>
</Project>
