<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Queryable Snapshot Store for Azure Cosmos DB</Title>
		<Description>Azure Cosmos DB queryable snapshot storage provider for Purview EventSourcing.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;event-store;queryable-store;snapshot;azure-cosmosdb;cosmosdb;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
		<ProjectReference Include="..\ImplementationShared\ImplementationShared.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.csproj" />
		<ProjectReference
			Include="..\EntityFrameworkCore.SourceGenerator\EntityFrameworkCore.SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
			Pack="false"
		/>
	</ItemGroup>

	<ItemGroup>
		<!-- The SDK is retained for container and indexing-policy provisioning, which EF does not emit. -->
		<PackageReference Include="Microsoft.Azure.Cosmos" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Cosmos" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
	</ItemGroup>
</Project>
