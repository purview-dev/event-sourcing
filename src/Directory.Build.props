<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview.EventSourcing</NamespacePrefix>
	</PropertyGroup>

	<Import Sdk="Purview.BuildSdk" Project="Sdk.props" />

	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>
			$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
		</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CS0436;</NoWarn>
		<!-- CS1574 (unresolvable cref) is suppressed because cross-assembly crefs cannot always be resolved;
		     CS1591 (missing XML docs) is deliberately reported so documentation is enforced on packable projects. -->
		<NoWarn>$(NoWarn);CS1574;</NoWarn>
		<AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'">
		<NoWarn>$(NoWarn);CA1031;CA2234</NoWarn>
	</PropertyGroup>

	<ItemGroup Label="TUnit integration test retries" Condition="'$(TestingType)' == 'Integration'">
		<AssemblyAttribute Include="TUnit.Core.Retry">
			<_Parameter1>3</_Parameter1>
			<_Parameter1_TypeName>System.Int32</_Parameter1_TypeName>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup Label="Purview site URL metadata">
		<PurviewHomepage>https://purview.dev/</PurviewHomepage>
		<PurviewProjectUrl>$(PurviewHomepage)projects/event-sourcing/</PurviewProjectUrl>
		<PurviewDocsUrl>$(PurviewHomepage)docs/event-sourcing/</PurviewDocsUrl>
	</PropertyGroup>

	<PropertyGroup Label="NuGet package metadata">
		<Authors>Kieron Lanning</Authors>
		<Company>Purview-Dev</Company>
		<Copyright>Copyright © $(CurrentYear) Purview-Dev</Copyright>
		<RepositoryUrl>https://github.com/purview-dev/event-sourcing.git</RepositoryUrl>
		<PackageProjectUrl>$(PurviewProjectUrl)</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>purview-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>

	<ItemGroup Label="NuGet package assets" Condition="'$(IsPackable)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)../assets/images/purview-logo.png" Link="Sdk\purview-logo.png" />
	</ItemGroup>

	<PropertyGroup Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'">
		<WarningsAsErrors>$(WarningsAsErrors);CA1031;CA1822</WarningsAsErrors>
	</PropertyGroup>
</Project>
