<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing</Title>
		<Description>Core abstractions, aggregate types, facades, transactions, and dependency injection extensions for building event-sourced .NET applications.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;eventstore;event-store;aggregate;domain-driven-design;</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGenerator\SourceGenerator.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
		<ProjectReference
			Include="..\SourceGenerator.CodeFixes\SourceGenerator.CodeFixes.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
		/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
		<PackageReference Include="Purview.ValueObjects" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Purview.BuildSdk 1.3.0 stopped contributing '.agents/**' content to packages - it packs
			the Sdk/ folder verbatim, so this project's bundled skills would land at
			'Sdk/.agents/skills/...', where nothing reads them. The package still ships those skills
			at '.agents/skills/...': that is the path ResolvePurviewSkillSources reads from a restored
			package, the path consuming repositories are told about in Sdk/README.md, and the path
			PackValidation:RequiredContent asserts. The tree is packed explicitly below, and its
			copy inside the packed Sdk/ folder is dropped first so the package carries one copy.
		-->
		<None Update="Sdk/.agents/**/*" Pack="false" Visible="false" />
		<None
			Include="Sdk/.agents/**/*"
			Pack="true"
			PackagePath=".agents/%(RecursiveDir)%(Filename)%(Extension)"
			Visible="false"
		/>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Extensions\Microsoft\Extensions\DependencyInjection\Manifest\" />
		<Folder Include="Extensions\Microsoft\Extensions\DependencyInjection\Outbox\" />
	</ItemGroup>
</Project>
