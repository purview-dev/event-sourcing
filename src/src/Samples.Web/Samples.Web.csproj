<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<NoWarn>$(NoWarn);CA1515;</NoWarn>
		<!--
			The only public type in this assembly is the `public partial class Program` that ASP.NET
			Core's public-program source generator emits for a top-level-statements entry point (the
			handle a test host references). It is generated, not authored here, so CA1515 cannot be
			fixed in this project: the suppression above is declared deliberate so Purview.BuildSdk's
			style policy (PRSGD0008) can tell it apart from an accidental one. This is the SDK's
			supported mechanism and keeps the rest of the accessibility policy enforced, unlike
			DisablePurviewStylePolicyValidation.
		-->
		<PurviewPolicyExemptNoWarn>$(PurviewPolicyExemptNoWarn);CA1515;</PurviewPolicyExemptNoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Azure.Storage.Blobs" />
		<PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Admin.API\Admin.API.csproj" />
		<ProjectReference Include="..\Admin.AzureStorage\Admin.AzureStorage.csproj" />
		<ProjectReference Include="..\Admin.MongoDB\Admin.MongoDB.csproj" />
		<ProjectReference Include="..\Admin.Postgres\Admin.Postgres.csproj" />
		<ProjectReference Include="..\Admin.Security\Admin.Security.csproj" />
		<ProjectReference Include="..\Admin.Site\Admin.Site.csproj" />
		<ProjectReference Include="..\Admin.SqlServer\Admin.SqlServer.csproj" />
		<ProjectReference Include="..\Samples.Shared\Samples.Shared.csproj" />
		<ProjectReference Include="..\Samples\Samples.csproj" />
		<ProjectReference Include="..\Samples.ServiceDefaults\Samples.ServiceDefaults.csproj" />
		<ProjectReference Include="..\AzureStorage\AzureStorage.csproj" />
		<ProjectReference Include="..\MongoDB\MongoDB.csproj" />
		<ProjectReference Include="..\Postgres\Postgres.csproj" />
		<ProjectReference Include="..\SqlServer\SqlServer.csproj" />
	</ItemGroup>
</Project>
